<!DOCTYPE html>
<html>
<head>
    <title>Cocktail Finder</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">

    <h1>🍹 Cocktail Finder</h1>

    <form action="/search" method="POST" class="search-box">
        <input type="text" name="drink" placeholder="Search for a cocktail..." required>
        <button type="submit">Search</button>
    </form>

    <form action="/random" method="GET">
        <button type="submit">🎲 Random Cocktail</button>
    </form>

</div>

</body>
</html>